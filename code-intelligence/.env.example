# LocalMind Environment Variables

# Ollama Configuration
OLLAMA_HOST=http://localhost:11434

# Repository Path (for docker-compose)
REPO_PATH=/path/to/your/repository

# OpenAI API Key (optional, for enhanced semantic enrichment)
# OPENAI_API_KEY=sk-...

# Application Settings
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Logging
LOG_LEVEL=INFO
